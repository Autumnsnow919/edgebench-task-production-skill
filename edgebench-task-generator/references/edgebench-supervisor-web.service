[Unit]
Description=EdgeBench Supervisor Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgebench
WorkingDirectory=/opt/edgebench-task-production-skill
ExecStart=/usr/bin/python3 /opt/edgebench-task-production-skill/edgebench-task-generator/scripts/topify_pipeline.py supervisor-web --scan-root /var/lib/edgebench/campaigns --host 0.0.0.0 --port 8787 --owner-token-file /etc/edgebench/owner.token
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
