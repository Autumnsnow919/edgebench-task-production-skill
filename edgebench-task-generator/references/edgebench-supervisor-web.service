[Unit]
Description=EdgeBench Supervisor Web Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edgebench
WorkingDirectory=/opt/edgebench-task-production-skill
ExecStart=/usr/bin/python3 /opt/edgebench-task-production-skill/edgebench-task-generator/scripts/topify_pipeline.py supervisor-web --scan-root /var/lib/edgebench/campaigns --host 0.0.0.0 --port 8787 --no-auth
Restart=always
RestartSec=5
TimeoutStartSec=120
ExecStartPost=/bin/sh -c 'for i in $(seq 1 110); do /usr/bin/curl --fail --silent http://127.0.0.1:8787/ >/dev/null && exit 0; sleep 1; done; exit 1'
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
