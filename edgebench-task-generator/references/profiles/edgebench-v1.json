{
  "schema_version": 1,
  "profile_id": "edgebench-v1",
  "benchmark": "EdgeBench",
  "requirements_precedence": [
    "user_requirements",
    "benchmark_requirements",
    "vendor_requirements",
    "profile_defaults"
  ],
  "delivery": {
    "formats": ["sforge-only", "harbor"],
    "default_format": null,
    "rollout_harness": "sforge"
  },
  "capabilities": {
    "reward_types": ["bounded_continuous"],
    "artifact_mode": "single-file",
    "architectures": ["linux/amd64", "linux/arm64"],
    "quality_ids": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"]
  },
  "thresholds": {
    "interaction_budget_seconds_minimum": 10800,
    "interaction_budget_seconds_preferred": 43200,
    "frontier_trials_minimum": 3,
    "reference_repeats": 5,
    "architectures_required": ["linux/amd64", "linux/arm64"],
    "q_review_required": ["Q1", "Q2", "Q3", "Q4", "Q5", "Q6", "Q7"],
    "q_review_not_required": ["Q8"]
  },
  "gate_ids": [
    "G_contract", "G_rubric", "G_endpoints", "G_difficulty", "G_semantics",
    "G_feedback", "G_security", "G_repro", "G_build", "G_pre_parity", "G_score_audit"
  ],
  "checks": {
    "continuous_reward": true,
    "structured_score": true,
    "native_cross_architecture": true,
    "source_rights_dedup": "not_required_by_owner",
    "sforge_dual_entry": "not_required_by_owner"
  },
  "supervision": {
    "employee_unit": "one-task",
    "qc": {
      "max_rounds": 2,
      "qc2_escalation": "supervisor-user"
    },
    "rollout": {
      "checkpoints": [
        {
          "name": "30m",
          "after_seconds": 1800,
          "mode": "observe",
          "metric": "best_score"
        },
        {
          "name": "1h",
          "after_seconds": 3600,
          "mode": "upper_bound",
          "metric": "best_score",
          "operator": "gte",
          "value": 80
        }
      ],
      "growth": {
        "enabled": true,
        "metric": "best_score",
        "baseline": "nop",
        "operator": "gt",
        "min_delta": 0
      },
      "final": {
        "source": "requirements-document",
        "low_result_action": "owner_review"
      }
    }
  }
}
